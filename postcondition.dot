// The postcondition of ndindex test_slice_reduce_no_shape_hypothesis (tests/test_slice.py:177-203) as an
// interprocedural control-flow graph (abridged), from the start of the test body, with ending nodes added:
// "pass" where the test returns, and a "violation" for every check, where the check fails.
// Branches are diamonds, checks are red boxes, other statements grey boxes. The bold edge is the one the
// failing inputs of mutant 41 take (helpers.py:399, numpy.testing.assert_equal raises;
// exploratory/violation-species chunks, 64 of 64). Helpers: check_same (helpers.py:421-500) and
// assert_equal (helpers.py:394-408); the exception handling inside check_same is left out.
// Render: dot -Tpdf postcondition.dot -o postcondition.pdf
digraph post {
  rankdir=TB; newrank=true; nodesep=0.15; ranksep=0.14;
  graph [fontname="Helvetica", fontsize=10];
  node [fontname="Courier", fontsize=10, height=0.22, margin="0.04,0.02"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.5, color="#555555"];

  subgraph cluster_test {
    label="test body"; style=rounded; color="#999999";
    start [label="start", shape=ellipse, color="#999999", fontname="Helvetica", fontsize=9];
    b178 [label="if shape is int", shape=diamond, color="#2a78d6"];
    s179 [label="a = arange(shape)", shape=box, color="#999999"];
    s181 [label="a = arange(...).reshape(...)", shape=box, color="#999999"];
    s183 [label="S = Slice(s)", shape=box, color="#999999"];
    call [label="check_same(a, S.raw, ...)", shape=box, color="#999999"];
    s193 [label="reduced = S.reduce(...)", shape=box, color="#999999"];
    a194 [label="assert start != None", shape=box, color="#c0392b"];
    b195 [label="if S.start >= 0", shape=diamond, color="#2a78d6"];
    a196 [label="assert start >= 0", shape=box, color="#c0392b"];
    a197 [label="assert step != None", shape=box, color="#c0392b"];
    b198 [label="if S.step", shape=diamond, color="#2a78d6"];
    a199 [label="assert |step| <= |S.step|", shape=box, color="#c0392b"];
    b200 [label="if stop is None", shape=diamond, color="#2a78d6"];
    a201 [label="assert S.stop is None", shape=box, color="#c0392b"];
    a203 [label="assert idempotent", shape=box, color="#c0392b"];
    pass [label="pass", shape=ellipse, style=filled, fillcolor="#e8f5e9", color="#4caf50", fontname="Helvetica", fontsize=9];
    start -> b178;
    b178 -> s179 [label="T"]; b178 -> s181 [label="F"]; s179 -> s183; s181 -> s183;
    s183 -> call;
    call -> s193 [style=invis];
    s193 -> a194;
    a194 -> b195 [label="T"];
    b195 -> a196 [label="T"]; b195 -> a197 [label="F"]; a196 -> a197 [label="T"];
    a197 -> b198 [label="T"]; b198 -> a199 [label="T"]; b198 -> b200 [label="F"]; a199 -> b200 [label="T"];
    b200 -> a201 [label="T"]; b200 -> a203 [label="F"]; a201 -> a203 [label="T"];
    a203 -> pass [label="T"];
  }

  subgraph cluster_helpers {
    label="check_same / assert_equal (test helpers)"; style=rounded; color="#999999";
    b496 [label="if not exception", shape=diamond, color="#2a78d6"];
    a396 [label="assert same type", shape=box, color="#c0392b"];
    b398 [label="if ndarray", shape=diamond, color="#2a78d6"];
    c399 [label="numpy assert_equal", shape=box, color="#c0392b"];
    a401 [label="assert shapes equal", shape=box, color="#c0392b"];
    a402 [label="assert dtypes equal", shape=box, color="#c0392b"];
    a408 [label="assert ==", shape=box, color="#c0392b"];
    ret [label="return", shape=ellipse, color="#999999", fontname="Helvetica", fontsize=9];
    node [shape=octagon, style=filled, fillcolor="#fdecea", color="#c0392b", fontname="Helvetica", fontsize=8, label="violation", height=0.18, margin="0.02,0.01"];
    v396; v408; v401; v402;
    v399 [fillcolor="#c0392b", fontcolor="#ffffff"];
    b496 -> a396 [label="T"]; b496 -> ret [label="F", tailport=e, headport=e];
    a396 -> b398 [label="T"];
    b398 -> a408 [label="F"];
    b398 -> c399 [label="T"]; c399 -> a401 [label="ok"]; a401 -> a402 [label="T"];
    a402 -> ret [label="T"]; a408 -> ret [label="T"];
    edge [style=dashed, color="#c0392b", fontcolor="#c0392b", fontsize=8];
    a396 -> v396 [label="F"];
    a408 -> v408 [label="F"];
    c399 -> v399 [label="raises", penwidth=2.2];
    a401 -> v401 [label="F"];
    a402 -> v402 [label="F"];
  }

  {rank=same; call; b496;}
  call -> b496 [style=dotted, label="call", constraint=false];
  ret -> s193 [style=dotted, label="return", constraint=false];

  // the violation of every check in the test body
  node [shape=octagon, style=filled, fillcolor="#fdecea", color="#c0392b", fontname="Helvetica", fontsize=8, label="violation", height=0.18, margin="0.02,0.01"];
  edge [style=dashed, color="#c0392b", fontcolor="#c0392b", fontsize=8];
  v194; a194 -> v194 [label="F"];
  v196; a196 -> v196 [label="F"];
  v197; a197 -> v197 [label="F"];
  v199; a199 -> v199 [label="F"];
  v201; a201 -> v201 [label="F"];
  v203; a203 -> v203 [label="F"];
}
